import sys, getopt, re, pprint, json

try:
    import requests
except ImportError:
    sys.stderr.write("cannot import requests. Try installing package python3-requests\n")
    sys.exit(1)

from requests.packages import urllib3
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

#
# usage information
#
def usage():
    sys.stderr.write("""CheckMK MikroTik Special Agent (REST API only)

USAGE: agent_mikrotik_rest_api -u <USER> -p <PASSWORD> [OPTIONS] <HOST>
       agent_mikrotik_rest_api -h

Queries a MikroTik device via the RouterOS REST API (RouterOS 7.1+,
service www-ssl for HTTPS, service www for HTTP from RouterOS 7.9).

ARGUMENTS:
  HOST                          Host name or IP address of the target device
  -u USER, --user USER          Username for MikroTik router login
  -p PASS, --pass PASS          Password for MikroTik router login

OPTIONS:
  -h, --help                    Show this help message and exit
  -n, --no-ssl                  Use HTTP instead of HTTPS (not recommended,
                                credentials are sent in plain text)
  -t, --skip-cert-check         Do not verify the HTTPS certificate
  -c PORT, --connect PORT       TCP port, default 443 (HTTPS) or 80 (HTTP)
  --timeout SECONDS             Timeout per request, default 15
  --debug                       Debug mode: write some debug messages,
                                let Python exceptions come through
  -i MODULES, --modules MODULES Modules to query. This is a comma separated list
                                which may contain the keywords "bgp", "ospf",
                                "health", "board", "vrrp", "ipsec", "firewall",
                                "file", "license", "ups", "pools", "ntp",
                                "wireguard", "mlag", "wifi" and "interfaces".
                                You can define to use only few of them to optimize
                                performance. The default is "all", which covers
                                every module except "wifi" and "interfaces"
                                (opt-in, name them explicitly).

""")


class RestError(Exception):
    """Connection or authentication problem: the agent cannot continue."""


def _excepthook(exc_type, exc, tb, _default=sys.excepthook):
    # a connection problem in the middle of the run: short message for the
    # Check_MK service instead of a traceback
    if issubclass(exc_type, RestError) and not opt_debug:
        sys.stderr.write("ERROR: %s\n" % exc)
        return  # the interpreter exits with status 1
    _default(exc_type, exc, tb)


sys.excepthook = _excepthook


# one HTTP session for all requests (keep-alive, auth once per request)
session = None
base_url = None


def rest_connect():
    global session, base_url
    session = requests.Session()
    session.auth = (user, password)
    # verify is also passed per request: REQUESTS_CA_BUNDLE in the
    # environment would otherwise override session.verify
    session.verify = certcheck
    session.headers['user-agent'] = 'CMK mikrotik-rest-api plugin'
    base_url = '%s://%s:%s/rest' % ('https' if secure else 'http',
                                    '[%s]' % host if ':' in host else host, port)


def _rest_request(method, path, body=None):
    """Return the decoded JSON as list of dicts, [] if the menu does not
    exist on this device (HTTP 400/404/406, e.g. wrong wireless driver)."""
    url = base_url + path
    try:
        if method == 'GET':
            response = session.get(url, timeout=opt_timeout, verify=certcheck)
        else:
            response = session.post(url, json=body or {}, timeout=opt_timeout,
                                    verify=certcheck)
    except requests.exceptions.SSLError as exc:
        raise RestError("HTTPS certificate problem (%s). For self-signed "
                        "certificates choose 'HTTPS - do not validate certificate'." % exc)
    except requests.exceptions.RequestException as exc:
        raise RestError("Connection to %s failed: %s" % (base_url, exc))

    if response.status_code in (401, 403):
        raise RestError("Access denied (HTTP %s) - check user, password and "
                        "user group policies (read, api)" % response.status_code)
    try:
        result = response.json()
    except ValueError:
        result = []
    if response.status_code >= 400:
        if opt_debug:
            print('\n# DEBUG %s %s -> HTTP %s %s' % (method, path, response.status_code, result))
        return []

    rows = result if isinstance(result, list) else [result]
    rows = [row for row in rows if isinstance(row, dict)]
    if opt_debug:
        print('\n# DEBUG_OUTPUT %s %s' % (method, path))
        pprint.pprint(rows)
    return rows


# print command as used in the module table: ["/ip/address/print"]
# -> GET /rest/ip/address
def myapi(command):
    path = command[0]
    if path.endswith('/print'):
        path = path[:-len('/print')]
    return _rest_request('GET', path)


# command with arguments, e.g. rest_post('/interface/ethernet/monitor',
# {'numbers': '*1,*2', 'once': ''}). Returns [] on errors, callers treat
# the data as optional.
def rest_post(path, body):
    try:
        return _rest_request('POST', path, body)
    except RestError:
        return []


# run a print command that may not exist on this device (wrong wireless
# driver, no CAPsMAN). myapi() returns [] for menus the device does not know;
# None is returned on errors and error rows.
def wifi_rows(api, command):
    try:
        rows = api([command])
    except Exception:
        return None
    for row in rows:
        if 'error' in row or ('message' in row and 'name' not in row
                              and 'interface' not in row):
            return None
    return rows

# wifi section, pipe separated because SSIDs may contain spaces:
#   iface|<driver>|<interface>|<ssid>|<up|down>
#   client|<driver>|<interface>|<ssid>|<signal dBm>|<band>
#   cap|<driver>|<identity>|<model>|<serial>|<version>|<base mac>|<state>
# Client MAC addresses are not reported on purpose. cap lines only come from a
# CAPsMAN controller, one per managed access point (for the HW/SW inventory).
def wifi_lines(api):
    lines = []
    for driver, iface_command, reg_command, config_command, cap_command in WIFI_SOURCES:
        if cap_command:
            for cap in wifi_rows(api, cap_command) or []:
                lines.append(['cap', driver, cap.get('identity', ''),
                              cap.get('board-name') or cap.get('board', ''),
                              cap.get('serial', ''), cap.get('version', ''),
                              cap.get('base-mac', ''), cap.get('state', '')])

        ifaces = wifi_rows(api, iface_command)
        if ifaces is None:
            continue

        # interfaces provisioned by CAPsMAN often only name a configuration
        # profile (configuration=cfg1) instead of an inline SSID
        profile_ssid = {}
        if config_command:
            for profile in wifi_rows(api, config_command) or []:
                if profile.get('name') and profile.get('ssid'):
                    profile_ssid[profile['name']] = profile['ssid']

        ssid_of = {}
        for iface in ifaces:
            name = iface.get('name')
            if not name or iface.get('disabled') == 'true':
                continue
            ssid = iface.get('configuration.ssid') or iface.get('ssid') \
                   or profile_ssid.get(iface.get('configuration', '')) or ''
            ssid_of[name] = ssid
            # CAP-operated interfaces always report running=false on the
            # controller; there bound + not inactive means the radio is up
            if 'bound' in iface:
                up = iface.get('bound') == 'true' and iface.get('inactive') != 'true'
            else:
                up = iface.get('running') == 'true'
            state = 'up' if up else 'down'
            lines.append(['iface', driver, name, ssid, state])

        for client in wifi_rows(api, reg_command) or []:
            name = client.get('interface', '')
            ssid = client.get('ssid') or ssid_of.get(name, '')
            # wifi: "-56", capsman: "-56", wireless: "-56@HT20-7"
            raw = client.get('signal') or client.get('rx-signal') \
                  or client.get('signal-strength') or ''
            match = re.match(r'-?\d+', raw)
            signal = match.group(0) if match else ''
            lines.append(['client', driver, name, ssid, signal,
                          client.get('band', '')])

    clean = lambda field: field.replace('|', '/').replace('\n', ' ')
    return ['|'.join(clean(field) for field in line) for line in lines]

# ---------------------------------------------------------------------------
# JSON modules: one JSON object per line, section header with sep(0).
# Only whitelisted fields are passed on (never keys or passwords).
# ---------------------------------------------------------------------------

def _pick(row, fields):
    return {k: row[k] for k in fields if k in row}


# /system/ups (package ups.npk) plus "monitor once" per UPS
def ups_rows():
    rows = []
    for ups in myapi(["/system/ups/print"]):
        if '.id' not in ups:
            continue
        mon = rest_post('/system/ups/monitor', {'numbers': ups['.id'], 'once': ''})
        row = _pick(ups, ['.id', 'name', 'model', 'serial', 'version',
                          'manufacture-date', 'nominal-battery-voltage',
                          'disabled', 'invalid', 'port'])
        row['monitor'] = mon[0] if mon else {}
        rows.append(row)
    return rows


# /ip/pool with the number of used addresses from /ip/pool/used (counted
# here, the list of leases itself is not passed on)
def pool_rows():
    pools = myapi(["/ip/pool/print"])
    if not pools:
        return []
    used = {}
    for row in myapi(["/ip/pool/used?.proplist=pool"]):
        used[row.get('pool', '')] = used.get(row.get('pool', ''), 0) + 1
    return [dict(_pick(p, ['name', 'ranges', 'next-pool', 'comment']),
                 used=used.get(p.get('name', ''), 0))
            for p in pools if p.get('name')]


# /system/ntp/client (single object)
def ntp_rows():
    return [_pick(row, ['enabled', 'mode', 'servers', 'server-dns-names',
                        'vrf', 'status', 'synced-server', 'synced-stratum',
                        'system-offset', 'freq-drift'])
            for row in myapi(["/system/ntp/client/print"])
            if 'enabled' in row or 'status' in row]


# /interface/wireguard/peers - without private and preshared keys
def wireguard_rows():
    return [_pick(row, ['.id', 'interface', 'name', 'comment', 'public-key',
                        'endpoint-address', 'endpoint-port',
                        'current-endpoint-address', 'current-endpoint-port',
                        'allowed-address', 'last-handshake', 'rx', 'tx',
                        'disabled', 'responder', 'persistent-keepalive'])
            for row in myapi(["/interface/wireguard/peers/print"])
            if row.get('interface')]


# MLAG: bridges with an MLAG peer port ("monitor once" for mlag-state and
# mlag-active-role) and bondings with an mlag-id ("monitor once" for the
# active/inactive ports and the LACP partner)
def _configured(value):
    return value not in (None, '', 'none')


def mlag_rows():
    rows = []
    for bridge in myapi(["/interface/bridge/print"]):
        if not _configured(bridge.get('mlag-peer-port')) or '.id' not in bridge:
            continue
        if bridge.get('disabled') == 'true':
            continue
        mon = rest_post('/interface/bridge/monitor', {'numbers': bridge['.id'], 'once': ''})
        row = _pick(bridge, ['name', 'mlag-peer-port', 'mlag-priority',
                             'mlag-heartbeat', 'running'])
        row['type'] = 'bridge'
        row['monitor'] = _pick(mon[0] if mon else {},
                               ['state', 'mlag-state', 'mlag-active-role',
                                'bridge-id', 'root-bridge'])
        rows.append(row)
    if not rows:
        return []  # no MLAG configured: no bonds to look at either
    for bond in myapi(["/interface/bonding/print"]):
        if not _configured(bond.get('mlag-id')) or '.id' not in bond:
            continue
        if bond.get('disabled') == 'true':
            continue
        mon = rest_post('/interface/bonding/monitor', {'numbers': bond['.id'], 'once': ''})
        row = _pick(bond, ['name', 'mlag-id', 'slaves', 'mode', 'running'])
        row['type'] = 'bond'
        row['monitor'] = _pick(mon[0] if mon else {},
                               ['mode', 'active-ports', 'inactive-ports',
                                'lacp-system-id', 'lacp-partner-system-id'])
        rows.append(row)
    return rows


JSON_MODULES = {
    'ups': ('mikrotik_rest_api_ups', ups_rows),
    'mlag': ('mikrotik_rest_api_mlag', mlag_rows),
    'pools': ('mikrotik_rest_api_pool', pool_rows),
    'ntp': ('mikrotik_rest_api_ntp', ntp_rows),
    'wireguard': ('mikrotik_rest_api_wireguard', wireguard_rows),
}


# "1Gbps" / "2.5Gbps" / "100Mbps" -> bit/s, 0 if unknown
def rate_to_bps(rate):
    match = re.match(r'([\d.]+)\s*([KMG])bps', rate or '')
    if not match:
        return 0
    factor = {'K': 10**3, 'M': 10**6, 'G': 10**9}[match.group(2)]
    return int(float(match.group(1)) * factor)

# interface section, pipe separated because comments may contain spaces:
#   <index>|<name>|<type>|<disabled>|<running>|<dynamic>|<mac>|<speed bit/s>|
#   <rx-byte>|<tx-byte>|<rx-packet>|<tx-packet>|<rx-error>|<tx-error>|
#   <rx-drop>|<tx-drop>|<comment>
# index is the RouterOS internal id (*1A -> 26): stable, unlike list positions.
# speed is only known for ethernet/SFP ports, taken from the negotiated rate
# (/interface/ethernet/monitor), not from the configured speed.
def interface_lines(api):
    ifaces = api(["/interface/print"])
    if not ifaces:
        return []

    # negotiated rate of all running ethernet ports in a single call
    running_ether = [i['.id'] for i in ifaces
                     if i.get('type') == 'ether' and i.get('running') == 'true'
                     and '.id' in i]
    speed_of = {}
    if running_ether:
        for row in rest_post('/interface/ethernet/monitor',
                             {'numbers': ','.join(running_ether), 'once': ''}):
            if row.get('name'):
                speed_of[row['name']] = rate_to_bps(row.get('rate'))

    lines = []
    for iface in ifaces:
        name = iface.get('name')
        ident = iface.get('.id', '')
        if not name or not ident.startswith('*'):
            continue
        try:
            index = str(int(ident[1:], 16))
        except ValueError:
            continue
        lines.append([
            index, name, iface.get('type', ''),
            iface.get('disabled', 'false'), iface.get('running', 'false'),
            iface.get('dynamic', 'false'), iface.get('mac-address', ''),
            str(speed_of.get(name, 0)),
            iface.get('rx-byte', '0'), iface.get('tx-byte', '0'),
            iface.get('rx-packet', '0'), iface.get('tx-packet', '0'),
            iface.get('rx-error', '0'), iface.get('tx-error', '0'),
            iface.get('rx-drop', '0'), iface.get('tx-drop', '0'),
            iface.get('comment', ''),
        ])

    clean = lambda field: str(field).replace('|', '/').replace('\n', ' ')
    return ['|'.join(clean(field) for field in line) for line in lines]

# command line options
short_options = 'hu:p:nc:i:t'
long_options  = [ 'help', 'user=', 'pass=', 'no-ssl', 'connect=', 'debug',
                  'modules=', 'skip-cert-check', 'timeout=' ]

try:
    opts, args = getopt.getopt(sys.argv[1:], short_options, long_options)
except getopt.GetoptError as err:
    sys.stderr.write("%s\n" % err)
    sys.exit(1)

opt_debug       = False
opt_timeout     = 15
secure          = True
port            = None
certcheck       = True

host            = None
user            = None
password        = None
mortypes        = [ 'all' ]
firewall_show_disabled = False

# modules and their REST paths (RouterOS 7, the REST API needs 7.1+)
command_options = {
    "bgp"           : {
                       "header"   : "mikrotik_rest_api_bgp",
