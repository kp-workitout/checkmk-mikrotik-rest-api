    "ups"           : {"header": "mikrotik_rest_api_ups", "active": False, "command": []},
    "pools"         : {"header": "mikrotik_rest_api_pool", "active": False, "command": []},
    "ntp"           : {"header": "mikrotik_rest_api_ntp", "active": False, "command": []},
